{
    admin off
    persist_config off
{% if monitoring_enabled | default(false) %}
    metrics
{% endif %}
    # Direct-IP HTTPS clients normally omit SNI.
    default_sni {{ public_api_address }}
    servers{% if monitoring_enabled | default(false) %} :443{% endif %} {
{% if monitoring_enabled | default(false) %}
        name public_gateway
{% endif %}
        protocols h1 h2
        max_header_size 16KiB
        timeouts {
            read_header 10s
            read_body 30s
            write {{ public_api_response_timeout }}s
            idle 60s
        }
    }
}

https://{{ public_api_address }} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Cache-Control no-store
    }
    route {
        # Cheap bounded admission runs before bcrypt. The guard learns only
        # credential digests after Caddy has authenticated the original request.
        forward_auth 127.0.0.1:{{ public_api_guard_port }} {
            uri /admit?
            header_up X-Guard-Client-IP {http.request.remote.host}
            header_up -X-Guard-User
            header_up -Cookie
            transport http {
                dial_timeout 1s
                response_header_timeout 2s
            }
        }
        basic_auth {
            {{ public_api_username }} {{ lookup('protected_bcrypt', public_api_password_hash_file) }}
        }
        forward_auth 127.0.0.1:{{ public_api_guard_port }} {
            uri /authenticated?
            header_up X-Guard-Client-IP {http.request.remote.host}
            header_up X-Guard-User {{ public_api_username }}
            header_up -Cookie
            transport http {
                dial_timeout 1s
                response_header_timeout 2s
            }
        }
        request_body {
            max_size {{ public_api_request_body_bytes }}
        }
{% if monitoring_enabled | default(false) %}
        @grafana path /grafana /grafana/*
        handle @grafana {
            reverse_proxy 127.0.0.1:3000 {
                # Only the authenticated gateway chooses the Grafana identity.
                header_up X-WEBAUTH-USER {{ public_api_username }}
                header_up -X-WEBAUTH-ROLE
                header_up -Authorization
                header_up -X-Guard-User
                header_up -X-Guard-Client-IP
                transport http {
                    dial_timeout 5s
                    response_header_timeout 60s
                }
            }
        }
{% endif %}
        @catalogue {
            method GET
            path /api/tags /v1/models
        }
        @inference {
            method POST
            path /api/chat /api/generate /v1/chat/completions /v1/completions
        }
        handle @catalogue {
            reverse_proxy 127.0.0.1:{{ public_api_upstream_port }} {
                header_up -Authorization
                header_up -Cookie
                header_up -X-Guard-User
                header_up -X-Guard-Client-IP
                transport http {
                    dial_timeout 5s
                    response_header_timeout 15s
                }
            }
        }
        handle @inference {
            reverse_proxy 127.0.0.1:{{ public_api_guard_port }} {
                header_up -Authorization
                header_up -Cookie
                header_up X-Guard-User {{ public_api_username }}
                header_up X-Guard-Client-IP {http.request.remote.host}
                transport http {
                    dial_timeout 5s
                    response_header_timeout {{ public_api_response_timeout }}s
                }
            }
        }
        # Model administration, arbitrary paths and methods are never proxied.
        respond 404
    }
}
{% if monitoring_enabled | default(false) %}

# A metrics-only listener; the Caddy administration API remains disabled.
http://127.0.0.1:2019 {
    bind 127.0.0.1
    route {
        metrics /metrics
        respond 404
    }
}
{% endif %}
