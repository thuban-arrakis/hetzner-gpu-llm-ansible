[Unit]
Description=Private repository ARM64 deployment runner
After=network-online.target ssh.service
Wants=network-online.target
ConditionPathExists=/tmp/llm-actions-runner/runner/.runner
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=llm-runner
Group=llm-runner
WorkingDirectory=/tmp/llm-actions-runner/runner
ExecStart=/tmp/llm-actions-runner/runner/runsvc.sh
Environment=HOME=/tmp/llm-actions-runner/home
Environment=TMPDIR=/tmp/llm-actions-runner/tmp
Environment=XDG_CACHE_HOME=/tmp/llm-actions-runner/cache
Environment=PIP_CACHE_DIR=/tmp/llm-actions-runner/cache/pip
Environment=ANSIBLE_HOME=/tmp/llm-actions-runner/home/.ansible
Environment=ANSIBLE_LOCAL_TEMP=/tmp/llm-actions-runner/tmp/ansible
Environment=DOTNET_CLI_HOME=/tmp/llm-actions-runner/home
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=GIT_TERMINAL_PROMPT=0
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
NoNewPrivileges=true
UMask=0077
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/tmp/llm-actions-runner
PrivateTmp=false
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
CPUQuota=100%
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target

