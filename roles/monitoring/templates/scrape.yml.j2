global:
  scrape_interval: {{ monitoring_scrape_interval }}
  scrape_timeout: 10s
  external_labels:
    deployment: llm-demo

scrape_configs:
  - job_name: victoriametrics
    static_configs:
      - targets: ["127.0.0.1:8428"]
  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:9100"]
  - job_name: llm
    static_configs:
      - targets: ["127.0.0.1:9400"]
  - job_name: caddy
    static_configs:
      - targets: ["127.0.0.1:2019"]
  - job_name: api_guard
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:{{ public_api_guard_port | default(11435) }}"]
  - job_name: grafana
    metrics_path: /grafana/metrics
    static_configs:
      - targets: ["127.0.0.1:3000"]
