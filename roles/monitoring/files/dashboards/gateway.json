    {
      "id": 5,
      "title": "Mean gateway handling duration \u00b7 5m",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "Mean server handling duration for completed requests through the public top-level route, including authentication, API/Grafana upstream work and response streaming. Idle means the Caddy scrape is healthy and the completed-request rate is zero over the last five minutes; no latency is invented. Unavailable means the scrape is down/missing or the duration telemetry is insufficient. This is not client end-to-end latency or LLM-only response time.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Idle \u00b7 no completions",
                  "color": "blue"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "(((sum(rate(caddy_http_request_duration_seconds_sum{job=\"caddy\",server=\"public_gateway\",handler=\"subroute\"}[5m])) / sum(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",server=\"public_gateway\",handler=\"subroute\"}[5m]))) and on() (sum(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",server=\"public_gateway\",handler=\"subroute\"}[5m])) > 0)) or on() ((sum(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",server=\"public_gateway\",handler=\"subroute\"}[5m])) == 0) - 1)) and on() (max(up{job=\"caddy\"}) == 1) and on() (sum(rate(caddy_http_request_duration_seconds_sum{job=\"caddy\",server=\"public_gateway\",handler=\"subroute\"}[5m])) >= 0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
